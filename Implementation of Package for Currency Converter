package currency;

public class CurrencyConverter {

    public double dollarToRupee(double dollar) {
        return dollar * 83.00;
    }

    public double euroToRupee(double euro) {
        return euro * 90.00;
    }

    public double poundToRupee(double pound) {
        return pound * 105.00;
    }
}
import java.util.Scanner;
import currency.CurrencyConverter;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        CurrencyConverter obj = new CurrencyConverter();

        System.out.print("Enter amount in Dollar: ");
        double dollar = sc.nextDouble();

        System.out.print("Enter amount in Euro: ");
        double euro = sc.nextDouble();

        System.out.print("Enter amount in Pound: ");
        double pound = sc.nextDouble();

        System.out.println("\n----- CURRENCY CONVERSION -----");
        System.out.println("Dollar to Rupee : Rs. " + obj.dollarToRupee(dollar));
        System.out.println("Euro to Rupee   : Rs. " + obj.euroToRupee(euro));
        System.out.println("Pound to Rupee  : Rs. " + obj.poundToRupee(pound));
    }
}
